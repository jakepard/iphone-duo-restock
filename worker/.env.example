# Private file. Copy as worker/.env on the server; never commit real values.
UPSTASH_REDIS_REST_URL=https://YOUR-UPSTASH-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_private_redis_rest_token
ALERT_RELAY_URL=https://iphone-duo-restock.vercel.app
ALERT_RELAY_SECRET=the_same_cron_secret_used_on_vercel
# Target starting intervals (seconds). Only use polling rates your authorized data source permits.
HOTSPOT_INTERVAL_SECONDS=30
FULL_RADIUS_INTERVAL_SECONDS=120
DASHBOARD_SYNC_SECONDS=60
